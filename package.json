{
  "name": "tijara-platform",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev:api": "cd apps/api && npm run start:dev",
    "dev:dashboard": "cd apps/dashboard && npm run dev",
    "dev:storefront": "cd apps/storefront && npm run dev",
    "setup": "cd apps/api && npm install && npx prisma generate && npx prisma migrate dev --name init && npx prisma db seed",
    "start": "echo 'Run each app separately'"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}